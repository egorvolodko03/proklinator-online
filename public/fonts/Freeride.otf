        <script>
    var seconds = 5;
    var started = false;
    function display()
    {
        $('.btn-free-element').hide();
        $('.download-timer').show();
        if (seconds == 0)
        {
            $('.download-timer').html("<a class='btn' href='https://uploadsfiles.com/6l4?pt=bUVCRWJxT1JEeWpKWWkwR2tQS0Z0a1ZKZWxOa09IbDBUMUJzUjNseFFsaFZhRkpuZDFFOVBRPT0%3D'><span class='btn__text'>DOWNLOAD / VIEW NOW</span></a>");
        } else
        {
            $('.download-timer-seconds').html(seconds);
        }
        seconds--;
    }
    
    function triggerFreeDownload() {
        if(started === true) {
            return;
        }
        
        started = true;
        display();
        countdownTimer = setInterval('display()', 1000);
    }

    //$(document).ready(function () {
    //    display();
    //    $('.download-timer-seconds').html(5);
    //    countdownTimer = setInterval('display()', 1000);
    //});
</script>

    
